// niri — main config. Adapted from trungdaohieutrung/endeavouros-niri.
// Linked to ~/.config/niri by Home Manager (read-only): edit the files in
// modules/aspects/misguided/niri/ and rebuild. `niri validate` checks them.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

overview {
    workspace-shadow {
        off
    }
}

config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.85 stiffness=650 epsilon=0.0001
    }
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

include "conf/colors.kdl"
include "conf/layout.kdl"
include "conf/alttab.kdl"
include "conf/binds.kdl"
include "conf/autostart.kdl"
include "conf/outputs.kdl"
include "conf/cursor.kdl"
include "conf/input.kdl"
include "conf/windowrules.kdl"
