// Window rules. Find an app's id with `niri msg windows`.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

// COSMIC Terminal: blur whatever shows through it. Turn on transparency in
// the terminal's own settings (View → Settings → Opacity) to see it.
window-rule {
    match app-id=r#"^com\.system76\.CosmicTerm$"#
    background-effect {
        blur true
        xray false
    }
    default-column-width { proportion 0.5; }
}

// Default rules

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

// COSMIC apps (Files, Text Editor, Settings…) draw their own rounded corners.
window-rule {
    match app-id=r#"^com\.system76\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^com\.system76\.CosmicSettings$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id=r#"^xdg-desktop-portal"#
    open-floating true
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
