{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 35,
  "border-radius": 25,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 2,
  "modules-left": ["image#logo", "niri/workspaces", "custom/separator#blank", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/right1"],

// GROUPS MODULE

  "group/right1": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "battery",
      "custom/separator#blank",
      "tray",
      "custom/separator#blank",
      "bluetooth",
      "idle_inhibitor",
      "custom/power"
    ]
  },

// MODULES

  "niri/window": {
    "format": "{title}",
    "rewrite": {
      "(.*) [-—] Mozilla Firefox": "🌎 $1"
    }
  },

  "niri/workspaces": {
    "format": "{index}"
  },

  "image#logo": {
    "path": "~/.config/waybar/nix-snowflake.svg",
    "size": 24,
    "on-click": "fuzzel",
    "tooltip": false
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "clock": {
    "format": " {:%I:%M %p • %a, %d/%m}     ",
    "format-alt": "{:%A, %d %B %Y}   ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "<span size='11500'>󰂯</span>",
    "format-disabled": "<span size='11500'>󰂲</span>",
    "format-connected": "<span size='11500'></span>",
    "format-no-controller": "<span size='11500'>󰂲</span>",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "cosmic-settings bluetooth"
  },

  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click": "cosmic-settings sound",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "custom/power": {
    "format": "",
    "on-click": "niri-power-menu",
    "tooltip-format": "Power Menu"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/separator#blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  }
}
