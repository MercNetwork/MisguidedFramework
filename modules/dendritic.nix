# Makes this a dendritic flake-parts flake: every file under modules/ is a
# module (loaded by import-tree), and flake.nix is generated by flake-file from
# the `flake-file.inputs` declarations (`nix run .#write-flake`).
{ inputs, ... }:
{
  imports = [
    inputs.flake-file.flakeModules.dendritic
    inputs.den.flakeModules.dendritic
  ];
}
